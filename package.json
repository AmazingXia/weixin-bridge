{
  "name": "@tencent-weixin/weixin-bridge",
  "version": "1.0.3",
  "description": "Standalone Weixin long-poll bridge",
  "license": "MIT",
  "author": "Tencent",
  "type": "module",
  "bin": {
    "weixin-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/standalone/index.js"
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/node_modules/",
    "README.md",
    "README.zh_CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh_CN.md"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc && chmod +x dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
